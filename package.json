{
  "name": "littlecrumb",
  "version": "0.0.1",
  "description": "Minimal file-based React SPA framework for Bun",
  "homepage": "https://littlecrumb.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asdiamond/littlecrumb.git"
  },
